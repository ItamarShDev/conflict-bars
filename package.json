{
	"name": "conflict-bars",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"generate-songs": "tsx scripts/generate-songs-json.ts",
		"predev": "npm run generate-songs",
		"prebuild": "npm run generate-songs",
		"dev": "next dev",
		"build": "next build --turbopack",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit",
		"migrate": "tsx scripts/migrate-data.ts",
		"migrate:force": "tsx scripts/migrate-data.ts --force",
		"migrate:events": "tsx scripts/migrate-events.ts",
		"migrate:language": "CONVEX_URL=$(grep -o 'https://[^\"]*' .env.local | head -1) tsx scripts/migrate-language.ts",
		"db:clear": "tsx scripts/clear-songs.ts",
		"reset-data": "npm run db:clear && npm run migrate",
		"reset-data:force": "npm run db:clear && npm run migrate:force"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"convex": "^1.43.0",
		"glob": "^13.0.6",
		"iconv-lite": "^0.7.2",
		"next": "^16.3.0",
		"nodemailer": "^9.0.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.1",
		"@types/nodemailer": "^8.0.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitest/ui": "^4.1.10",
		"dotenv": "^17.4.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.7",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
